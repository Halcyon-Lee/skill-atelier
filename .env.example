# Copy to .env.local and change these values before first launch.
# They are consumed only when the SQLite database is first seeded.

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-password
SEED_INVITE_CODE=YOUR-INVITE-CODE

# Public URL, used for metadata and absolute links.
SITE_URL=https://your-domain.com

# Set to false only when running over plain HTTP on a non-local host.
COOKIE_SECURE=true

# Optional: absolute path to the SQLite file.
# DATABASE_PATH=/var/lib/atelier/atelier.db

# Only used by docker compose deployments.
# APP_IMAGE=atelier:local
# BIND_ADDRESS=127.0.0.1
# TZ=Asia/Shanghai
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-stable-32-byte-base64-key
